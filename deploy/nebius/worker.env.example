# Copy to /etc/wake-worker.env on the Nebius GPU VM and chmod it 0600.
# Pin production images by digest after pushing them to Container Registry.
WAKE_IMAGE=
WAKE_CONTAINER=wake_hands_segmentation_worker

WAKE_DEVICE=cuda
WAKE_S3_ENDPOINT_URL=https://storage.eu-north1.nebius.cloud
WAKE_S3_REGION=eu-north1
AWS_ACCESS_KEY_ID=REPLACE_WITH_NEBIUS_ACCESS_KEY_AWS_ID
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_NEBIUS_SECRET_ACCESS_KEY

# Optional service overrides.
# WAKE_REFINEMENT_MODE=low
# WAKE_HTTP_THREADS=8
# WAKE_REQUEST_MAX_BYTES=1048576
# WAKE_VIDEO_DECODER=nvdec
# WAKE_TEMPORAL_STRIDE=60
# WAKE_CUDA_GRAPH_BATCH_SIZE=6
