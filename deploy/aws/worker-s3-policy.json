{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTestInputs",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::wake-ai-gpu-test-302659228101-eu-north-1/jobs/*/input/*"
    },
    {
      "Sid": "WriteTestResults",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::wake-ai-gpu-test-302659228101-eu-north-1/jobs/*/results/*"
    }
  ]
}
